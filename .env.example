# Optional server-side Gemini analysis provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional alternative provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Groq provider (fast Llama inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenRouter provider (access many models via one key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional local Ollama provider (no API key required)
# 1. Install Ollama: https://ollama.com/download
# 2. Run: ollama serve
# 3. Pull a model: ollama pull llama3
# 4. Set the vars below and restart NyayaTrace
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
